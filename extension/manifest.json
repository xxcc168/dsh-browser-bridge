{
  "manifest_version": 3,
  "name": "DSH Browser Bridge",
  "version": "1.2.0",
  "description": "让 DeepSeek Harness 读取并控制当前浏览器：查看页面内容、点击、输入、按键、滚动、打开/关闭标签页、截图。",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "scripting",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DSH Browser Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
